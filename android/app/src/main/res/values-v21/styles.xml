<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme for a full-screen launch screen. This is a crucial step to hide the status bar during startup. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Theme for the main Flutter app. This ensures the status bar remains hidden after launch. -->
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- This line is the most important change. It forces the app to be full screen. -->
        <item name="android:windowFullscreen">true</item>

        <!-- The rest of your theme properties -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
</resources>